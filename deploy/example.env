# Локальные настройки деплоя: скопируйте в .env и заполните своими значениями.
# .env добавлен в .gitignore — реальные адреса и пароль в git не попадают.
SFTP_PASSWORD='...'
VPS_HOST=files.example.com
DOMAIN=files.example.com

# Опционально (по умолчанию: root / HTTPS / без email):
# SSH_USER=root
# NO_SSL=0
# EMAIL=you@example.com   # контактный адрес Let's Encrypt; без него — регистрация без email
