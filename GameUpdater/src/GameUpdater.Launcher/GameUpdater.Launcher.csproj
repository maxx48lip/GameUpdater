<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameUpdater.Launcher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameUpdater.Shared\GameUpdater.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample config is copied next to the exe so a fresh build runs out of the box. -->
    <None Update="launcher.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
